# Application under test

BASE_URL=https://home.kornferrytalent-qa.com

BASE_URL_DEV=https://home.kornferrytalent-dev.com

BASE_URL_STAGE=https://home.kornferrytalent-stage.com

BASE_URL_PROD_US=https://home.kornferrytalent.com

BASE_URL_PROD_EU=https://home.kornferrytalent.eu



# Run smoke scenarios on multiple environments (comma-separated: qa,dev,stage,prod_us,prod_eu)

SMOKE_ENVIRONMENTS=qa,dev,stage,prod_us,prod_eu

# Test credentials (use test accounts only)

TEST_USERNAME=kfpay_automation@testfky.com

# Fallback user if primary login fails
# TEST_USERNAME_FALLBACK=clm.user.two@testkfy.com

TEST_PASSWORD=demo_password



# Production passwords (used only for prod_us and prod_eu smoke runs)

# TEST_PASSWORD_PROD_US=your_prod_us_password

# TEST_PASSWORD_PROD_EU=your_prod_eu_password

# Or set a shared prod password for both:

# TEST_PASSWORD_PROD=your_prod_password



# Client selection (for admin / multi-client users)

# TEST_PAMS_ID=

# TEST_CLIENT_NAME=CLM Test Company 1



# Environment: dev | test | stage | prod_us | prod_eu | prodeu | produs | prodhk

ENV=dev



# Browser settings

HEADLESS=true

SLOW_MO=0

KEEP_BROWSER_OPEN=false



# Retry failed scenarios once after recovering (e.g. return to Pay dashboard). Set 0 to disable.

SCENARIO_RETRY_COUNT=1



# Allure report file prefix (output: daily_login_check_MM-dd-yyyy_HH-mm-ss.html)

# ALLURE_REPORT_PREFIX=daily_login_check

# ALLURE_REPORT_TITLE=Login check

